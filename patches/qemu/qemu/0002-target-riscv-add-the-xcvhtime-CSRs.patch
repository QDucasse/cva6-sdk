@@ -985,5 +993,8 @@ const char *satp_mode_str(uint8_t satp_mode, bool is_32_bit);
 /* In th_csr.c */
 extern const RISCVCSR th_csr_list[];
 
+/* In xcv_csr.c */
+extern const RISCVCSR xcv_csr_list[];
+
 const char *priv_spec_to_str(int priv_version);
 #endif /* RISCV_CPU_H */
diff --git a/target/riscv/cpu_bits.h b/target/riscv/cpu_bits.h
index b62dd82fe7..fd198a0bc7 100644
--- a/target/riscv/cpu_bits.h
+++ b/target/riscv/cpu_bits.h
@@ -274,6 +274,15 @@
 #define CSR_HTIMEDELTA      0x605
 #define CSR_HTIMEDELTAH     0x615
 
+/* CORE-V hidden time (xcvhtime), RV64 only */
+#define CSR_XCV_HTIMECTL        0x6C0
+#define CSR_XCV_HEXIT_TIME      0x6C1
+#define CSR_XCV_HHIDDEN_TIME    0x6C2
+#define CSR_XCV_HVTIMECMP       0x6C3
+#define CSR_XCV_HEXIT_CYCLE     0x6C4
+#define CSR_XCV_HHIDDEN_CYCLE   0x6C5
+#define XCV_HTIMECTL_HHAE       BIT(0)
+
 /* Hypervisor Configuration CSRs */
 #define CSR_HENVCFG         0x60A
 #define CSR_HENVCFGH        0x61A
diff --git a/target/riscv/meson.build b/target/riscv/meson.build
index fdefe88ccd..d1f6586005 100644
--- a/target/riscv/meson.build
+++ b/target/riscv/meson.build
@@ -38,6 +38,7 @@ riscv_system_ss.add(files(
   'machine.c',
